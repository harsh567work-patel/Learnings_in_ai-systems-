import os
from pathlib import Path
from pyexpat import model
from dotenv import load_dotenv
from groq import Groq  

load_dotenv()

my_api_key = os.getenv("GROQ_API_KEY")

if not my_api_key:
    raise ValueError("GROQ_API_KEY environment variable is not set.")

client = Groq(api_key=my_api_key)
model = "openai/gpt-oss-120b"
role = "user"

#multiple prompts to test token usage
prompt1 = "Hi!"
prompt2 = "Write a short poem about the beauty of nature."
prompt3 = "Write a short poem about the beauty of nature in the style of Shakespeare."

prompts = [prompt1, prompt2, prompt3]
for prompt in prompts:
    message = {
        'role': role,
        'content': prompt
    }
    #setting max_tokens to 500 to limit the response length and avoid excessive token usage
    message = [message]
    response = client.chat.completions.create(model = model ,  messages=message , max_tokens=500)
    usage = response.usage
    #categories of tokens used in the response , your tokens are the tokens used in the prompt, completion tokens are the tokens used in the response, and total tokens are the sum of both
    print(f"Prompt: {prompt} --> your_tokens: {usage.prompt_tokens}, completion_tokens: {usage.completion_tokens}, total_tokens: {usage.total_tokens} ,  Finish_reason: {response.choices[0].finish_reason}")

    


