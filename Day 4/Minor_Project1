class MatchResult(BaseModel):
    score : float
    details : dict
class Experience(BaseModel):
    company : str | None = None
    role : str | None = None
    duration : str | None = None
    description : str | None = None
    skills : list[str] = []
class Resume(BaseModel):
    name : str
    email : str
    phone : str
    summary : str | None = None
    experiences : list[Experience] = []
    skills : list[str] = []
    experience_years : float | None = None
    projects : list[dict] = []
    certifications : list[str] = []

resume_schema = Resume.model_json_schema()
def final_score(job , resume):
    match_schema = MatchResult.model_json_schema()
    prompt = f"""
    You are an expert HR assistant.
    Your job is to analyze a job description and a resume, and provide a match score based on the following criteria:
    
    Compare the candidate's skills, experience, and qualifications with the requirements of the job description.
    Return ONLY VALID JSON that conforms to the following schema:

    1. The match score should be a float between 0 and 1, where 1 indicates a perfect match and 0 indicates no match.
    2. The details field should contain a dictionary with the following keys:
        - "skills_match": a list of skills that match between the job description and the resume.
        - "experience_match": a list of experiences that match between the job description and the resume.
        - "education_match": a boolean indicating whether the candidate's education matches the job requirements.
        - "certifications_match": a list of certifications that match between the job description and the resume.
    3. If any information is not available, return an empty list or False for that field.
    4. Do not invent information. If a field is not mentioned in the job description or resume, return an empty list or False for that field.
    
    """
    message = {
        "role": "user",
        "content": prompt
    }

    messages = [message_system, message, {
        "type" : "json_object"
    }]

    response = client.chat.completions.create(
        model=model,
        messages=messages,
        response_format=response_format)
    data = json.loads(response.choices[0].message.content)
    return MatchResult(**data)

def parse_resume(resume_text):
    prompt = f"""
    You are an expert HR assistant.
    Your job is to analyze a resume and extract relevant information.
    Return ONLY VALID JSON that conforms to the following schema:

    {resume_schema}
    IMPORTANT: Do not return the schema itself,
    DO NOT return fields like "properties", "title" and "type"
    Fill the schema with the actual data extracted from the resume.
    If information is not available, return an empty list for that field.
    Do not invent information. If a field is not mentioned in the resume, return an empty list for that field.
    """

    user_prompt = f"""
Analyze the following resume and extract relevant information according to the schema provided in the system prompt.
{resume_text}"""

    message_system = {
        "role": "system",
        "content": prompt
    }

    message_user = {
        "role": "user",
        "content": user_prompt
    }

   
    messages = [message_system, message_user, {
        "type" : "json_object"
    }]

    response = client.chat.completions.create(
        model=model,
        messages=messages,
        response_format=response_format)
    raw_output =  response.choices[0].message.content
    data = json.loads(raw_output)
    resume = Resume(**data)
    return resume

from pypdf import PdfReader
from docx import Document
def read_pdf(file_path):
    reader = PdfReader(file_path)
    text = ""
    for page in reader.pages:
        page_text = page.extract_text()
        if page_text:
            text += page_text + "\n"
    return text

def read_docx(file_path):
    doc = Document(file_path)
    text = ""
    for para in doc.paragraphs:
        text += para.text + "\n"
    return text
